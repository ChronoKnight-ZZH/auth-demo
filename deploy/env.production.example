# /etc/auth-demo/env —— 生产环境变量（权限 600，属主 root:authsvc）
# 复制后填入真实值；不要提交到版本库。
# RSA 私钥、PEPPER 由 systemd LoadCredential 注入，不写在这里。

NODE_ENV=production
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=true

# 生产 TLS 由 Nginx 终结（deploy/nginx-api.conf），应用只监听回环 HTTP：
# TLS_ENABLED 必须保持关闭（本地联调用时才开，见 README「本地 HTTPS 测试」）
TLS_ENABLED=0

# ---- 前端分域直连：必须列出 chat 域名，否则浏览器跨域被拦 ----
CORS_ORIGINS=https://chat.shunkai-dg.cn
CORS_MAX_AGE_SEC=600
# 分域同站点时 same-site；前端与 API 不同站点再改 cross-origin
FILES_CORP=same-site

# ---- MySQL / Redis（只监听回环）----
MYSQL_URL=mysql://authdemo:CHANGE_ME@127.0.0.1:3306/auth_demo
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
MYSQL_POOL_SIZE=8

# ---- Argon2 / 会话 / 登录限流（默认值，可按 2C4G 基线保留）----
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=604800000
SESSION_TOUCH_THROTTLE_MS=300000
LOGIN_MAX_PER_ACCOUNT=10
LOGIN_MAX_PER_IP=50
LOGIN_WINDOW_SEC=900
MAX_CONCURRENT_HASH=2
HASH_QUEUE_LIMIT=32
HASH_QUEUE_TIMEOUT_MS=1000

# ---- 附件原件 ----
FILES_MODE=local
FILES_DIR=/var/lib/auth-demo/files
FILES_MAX_BYTES=67108864
# 文本内联预览的转码上限；超出仍按附件下载
FILES_TEXT_MAX_BYTES=16777216
# openssl rand -base64 48
FILE_TOKEN_SECRET=CHANGE_ME_48_BYTES
FILE_TOKEN_TTL_MS=1800000
DEDUPE_SCOPE=global

# ---- 上游：Key 只在服务端 ----
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=CHANGE_ME
# 可选路径覆盖
# UPSTREAM_MESSAGES_PATH=/anthropic/v1/messages
# UPSTREAM_MODELS_PATH=/models
# UPSTREAM_FILES_PATH=/anthropic/v1/files
# UPSTREAM_ASR_PATH=/v1/tools/asr
# UPSTREAM_TTS_PATH=/v1/tools/tts
# UPSTREAM_BALANCE_PATH=/user/balance
# UPSTREAM_BALANCE_TIMEOUT_MS=15000

# ---- Agent Harness（阶段 1：默认关闭；执行器尚未接入）----
# 开启后才会挂载 /api/agent/tasks；AGENT_ALLOWLIST 为空表示所有已登录用户可用。
AGENT_ENABLED=0
# 逗号分隔的用户 ID，例如 AGENT_ALLOWLIST=1,2
AGENT_ALLOWLIST=
# 阶段 1 必须保持 0；阶段 2/3 接入模型与 Docker 后再开启
AGENT_EXECUTION_ENABLED=0
# off = 任务只落库排队；bullmq = 投递到独立 Worker
AGENT_QUEUE_MODE=off
AGENT_QUEUE_NAME=agent-tasks
AGENT_QUEUE_PREFIX=agent
AGENT_QUEUE_ENQUEUE_TIMEOUT_MS=3000
AGENT_WORKER_CONCURRENCY=1
AGENT_MYSQL_POOL_SIZE=4
# 模型名；地址/Key/路径复用上面的 UPSTREAM_* 配置
AGENT_MODEL=deepseek-chat
AGENT_MAX_TOKENS=4096
AGENT_TASK_TIMEOUT_MS=600000
AGENT_SCRIPT_TIMEOUT_MS=120000
AGENT_MAX_MODEL_CALLS=12
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_INPUT_FILES=20
AGENT_MAX_INPUT_BYTES=134217728
AGENT_MAX_OUTPUT_BYTES=67108864
AGENT_MAX_OUTPUT_FILES=10
AGENT_USER_QUOTA_BYTES=21474836480
AGENT_RETENTION_DAYS=30
AGENT_LOG_RETENTION_DAYS=7
AGENT_OUTPUT_RETENTION_DAYS=30
AGENT_WORKSPACE_DIR=/var/lib/auth-demo/agent
# 阶段 3 使用
AGENT_PYTHON_IMAGE=agent-python:1
AGENT_CONTAINER_MEMORY_BYTES=805306368
AGENT_CONTAINER_CPUS=1
AGENT_CONTAINER_PIDS_LIMIT=128

# ---- SSE / 缓冲 ----
STREAM_MAX_CONCURRENT=64
STREAM_MAX_PER_USER=4
SSE_HEARTBEAT_MS=10000
STREAM_BUFFER_MAX_EVENTS=8000
STREAM_BUFFER_MAX_BYTES=4194304
STREAM_BUFFER_TTL_MS=600000
STREAM_ORPHAN_TIMEOUT_MS=90000

# ---- 备份脚本（systemd timer 也读取本文件）----
BACKUP_DIR=/var/backups/auth-demo
BACKUP_RETENTION_DAYS=30
# 可选：同步到挂载的异地目录（NFS/对象存储挂载点）
# OFFSITE_DIR=/mnt/offsite/auth-demo
