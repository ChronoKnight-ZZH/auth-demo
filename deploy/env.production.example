# /etc/auth-demo/env —— 生产环境变量（权限 600，属主 root:authsvc）
# 复制后填入真实值；不要提交到版本库。
# RSA 私钥、PEPPER 由 systemd LoadCredential 注入，不写在这里。

NODE_ENV=production
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=true

# ---- 前端分域直连：必须列出 chat 域名，否则浏览器跨域被拦 ----
CORS_ORIGINS=https://chat.shunkai-dg.cn
CORS_MAX_AGE_SEC=600
# 分域同站点时 same-site；前端与 API 不同站点再改 cross-origin
FILES_CORP=same-site

# ---- MySQL / Redis（只监听回环）----
MYSQL_URL=mysql://authdemo:CHANGE_ME@127.0.0.1:3306/auth_demo
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
MYSQL_POOL_SIZE=8

# ---- Argon2 / 会话 / 登录限流（默认值，可按 2C4G 基线保留）----
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=604800000
SESSION_TOUCH_THROTTLE_MS=300000
LOGIN_MAX_PER_ACCOUNT=10
LOGIN_MAX_PER_IP=50
LOGIN_WINDOW_SEC=900
MAX_CONCURRENT_HASH=2
HASH_QUEUE_LIMIT=32
HASH_QUEUE_TIMEOUT_MS=1000

# ---- 附件原件 ----
FILES_MODE=local
FILES_DIR=/var/lib/auth-demo/files
FILES_MAX_BYTES=67108864
# openssl rand -base64 48
FILE_TOKEN_SECRET=CHANGE_ME_48_BYTES
FILE_TOKEN_TTL_MS=1800000
DEDUPE_SCOPE=global

# ---- 上游：Key 只在服务端 ----
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=CHANGE_ME
# 可选路径覆盖
# UPSTREAM_MESSAGES_PATH=/anthropic/v1/messages
# UPSTREAM_MODELS_PATH=/models
# UPSTREAM_FILES_PATH=/anthropic/v1/files
# UPSTREAM_ASR_PATH=/v1/tools/asr
# UPSTREAM_TTS_PATH=/v1/tools/tts

# ---- SSE / 缓冲 ----
STREAM_MAX_CONCURRENT=64
STREAM_MAX_PER_USER=4
SSE_HEARTBEAT_MS=10000
STREAM_BUFFER_MAX_EVENTS=8000
STREAM_BUFFER_MAX_BYTES=4194304
STREAM_BUFFER_TTL_MS=600000
STREAM_ORPHAN_TIMEOUT_MS=90000

# ---- 备份脚本（systemd timer 也读取本文件）----
BACKUP_DIR=/var/backups/auth-demo
BACKUP_RETENTION_DAYS=30
# 可选：同步到挂载的异地目录（NFS/对象存储挂载点）
# OFFSITE_DIR=/mnt/offsite/auth-demo
