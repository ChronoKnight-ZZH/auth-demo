# ---- 服务 ----
# 开发环境使用 development，生产环境使用 production
NODE_ENV=development
# 服务监听主机，0.0.0.0 表示所有接口
HOST=0.0.0.0
# 服务监听端口
PORT=3000

# ---- TLS（本地 HTTPS 测试；生产仍由 Nginx 终结 TLS，应用只监听回环 HTTP）----
# 打开后应用自身用 https.createServer 监听，浏览器可直接访问 https://127.0.0.1:3000
# 开启前先执行：npm run cert   （生成 secrets/tls_cert.pem + secrets/tls_key.pem 自签证书）
# TLS_ENABLED=1
# 证书与私钥路径（相对仓库根目录或绝对路径）
# TLS_CERT_PATH=secrets/tls_cert.pem
# TLS_KEY_PATH=secrets/tls_key.pem
# 可选：附加 CA 证书（PEM），自签链 / 企业 CA 场景
# TLS_CA_PATH=
# 额外起一个纯 HTTP 端口并 301 跳到 HTTPS（0 = 不启用），用于本地复现强制跳转
# TLS_REDIRECT_HTTP_PORT=0
# 跳转时使用的 Host；留空 = 取请求的 Host 头
# TLS_REDIRECT_HOST=
# 注意：TLS_ENABLED=1 时 TRUST_PROXY 默认关闭（应用直连 TLS，不再信任 X-Forwarded-* 头）；
# 若前面还有反向代理，显式设 TRUST_PROXY=1

# ---- CORS（仅前后端分域部署需要）----
# 前端 chat.shunkai-dg.cn 直连本站 api.shunkai-dg.cn 时必须配置；
# 同源反代（前端 Nginx 转发 /auth、/v1）留空即可，跨域头完全不产生。
# 逗号分隔白名单；`*` = 反射任意来源（注意：会话已改走 HttpOnly Cookie，分域部署不可用 `*`，且 CSRF 防护依赖此白名单）
# 本地联调：前端 devServer（https://localhost:8090）代理到本站时 Origin 原样转发、Host 被改写 → 不同源，
# 不配会 403「请求来源不被允许」；此时填前端开发地址即可。
# CORS_ORIGINS=https://chat.shunkai-dg.cn
# 本地前端联调示例：CORS_ORIGINS=https://localhost:8090
# CORS_MAX_AGE_SEC=600

# ---- login 密钥与 pepper（生产环境必须通过 Secret 注入，勿提交）----
PEPPER=dev-pepper-change-me-in-production-0123456789

# ---- Argon2id ----
# 内存成本（KiB），默认 19456
ARGON2_MEMORY_KIB=19456
# 时间成本（秒），默认 2
ARGON2_TIME_COST=2
# 并行成本（默认 1）
ARGON2_PARALLELISM=1

# ---- 会话 TTL（方案 §10 Q-04 定稿）----
# 会话空闲时间（毫秒），默认 1800000ms
SESSION_IDLE_MS=1800000
# 会话绝对时间（毫秒），默认 604800000ms
SESSION_ABSOLUTE_MS=604800000
# 会话触摸节流时间（毫秒），默认 300000ms
SESSION_TOUCH_THROTTLE_MS=300000

# ---- 会话 Cookie（HttpOnly 由后端下发；前端不再持有 token 原文）----
# 会话 Cookie 名称，默认 authdemo.session
# SESSION_COOKIE_NAME=authdemo.session
# 会话 Cookie 路径，默认 /
# SESSION_COOKIE_PATH=/

# 留空 = host-only（同源反代推荐，最收敛）；分域直连 chat.X→api.X 时设 .shunkai-dg.cn
# 注意：不要写死成 api.域名，否则浏览器不会把 Cookie 发给 chat.域名
# SESSION_COOKIE_DOMAIN=

# lax（默认，同站可带、挡跨站）/ strict / none（none 必须同时 Secure=true）
# SESSION_COOKIE_SAMESITE=lax
# 留空按 NODE_ENV 自动（production=true）
# SESSION_COOKIE_SECURE=

# 状态变更请求（POST/PUT/PATCH/DELETE）校验 Origin/Referer 白名单；CLI/curl 直连测试可设 0
# CSRF_ENABLED=true

# ---- 登录限流（方案 §10 Q-06 定稿）----
# 每个账号最多登录次数，默认 10
LOGIN_MAX_PER_ACCOUNT=10
# 每个 IP 最多登录次数，默认 50
LOGIN_MAX_PER_IP=50
# 登录窗口时间（秒），默认 900s
LOGIN_WINDOW_SEC=900

# ---- Argon2 并发闸（方案 §6.2.6）----
# 最大并发哈希数，默认 2
MAX_CONCURRENT_HASH=2
# 哈希队列长度，默认 32
HASH_QUEUE_LIMIT=32
# 哈希队列超时时间（毫秒），默认 1000ms
HASH_QUEUE_TIMEOUT_MS=1000

# ---- 存储后端 ----
# 留空 = 使用内存实现（零依赖开箱可跑）
# 填入即启用真实后端，例如：
# MYSQL_URL=mysql://authdemo:password@127.0.0.1:3306/authdemo
# REDIS_URL=redis://:password@127.0.0.1:6379/0
MYSQL_URL=mysql://deepseek:123456@127.0.0.1:3306/deepseek
REDIS_URL=redis://127.0.0.1:6379/0
# 数据库连接池大小，默认 8
MYSQL_POOL_SIZE=8

# ---- 附件原件 ----
# local：服务端保存原件并签发短期票据；off：退回纯 IndexedDB
FILES_MODE=local
# 生产请挂载独立磁盘；默认仓库内 data/files
FILES_DIR=/data/authdemo/files
# 单文件上限（字节），默认 64 MiB
FILES_MAX_BYTES=67108864
# 文本内联预览的转码上限（字节），默认 16 MiB；超出仍按附件下载
FILES_TEXT_MAX_BYTES=16777216
# 票据 HMAC 密钥；生产必须显式设置并随密钥轮换
FILE_TOKEN_SECRET=sk-echo-any-non-empty-value
# 票据过期时间（毫秒），默认 1800000ms
FILE_TOKEN_TTL_MS=1800000
# global：跨用户按 sha256 去重；user：只在用户内去重
DEDUPE_SCOPE=global

# /files/content 的 Cross-Origin-Resource-Policy（<img> 跨源加载，独立于 CORS）。
# 留空自动：CORS_ORIGINS 非空（分域直连）→ same-site；为空（同源反代）→ same-origin。
# 前端与后端不同「站点」（如 github.io 预览）时设 cross-origin。

# same-site：前端与后端同源，不跨域加载
# cross-origin：前端与后端不同源，跨域加载
FILES_CORP=same-site

# ---- 上游（BFF；Key 只在服务端）----
# 生产请填 https://api.deepseek.com，本地请填 http://127.0.0.1:8788,先 `npm run mock:echo` 启动本地模拟服务
UPSTREAM_BASE_URL=https://api.deepseek.com
# 上游 API Key，生产请填 deepseek API Key，本地请填 sk-echo-any-non-empty-value
# 必填；未设置时 /v1/* 返回 503 UPSTREAM_NOT_CONFIGURED
UPSTREAM_API_KEY=sk-echo-any-non-empty-value


# ---- Agent Harness（阶段 1：默认关闭）----
# 开启后挂载 /api/agent/tasks；执行器与 Docker 尚未接入
# AGENT_ENABLED=1
# 逗号分隔的用户 ID 白名单；留空 = 所有已登录用户
# AGENT_ALLOWLIST=
# 阶段 1 保持 0；阶段 2/3 接入模型与 Docker 后再开启
# AGENT_EXECUTION_ENABLED=0
# off = 只落库排队；inline = 进程内执行（仅开发）；bullmq = 独立 Worker
# AGENT_QUEUE_MODE=off
# AGENT_MODEL=deepseek-chat
# AGENT_WORKSPACE_DIR=./data/agent
# 排队上限：任务停在 queued 超过这个时间仍没人领取 → 判 timed_out（AGENT_QUEUE_TIMEOUT）
# 没有它，Worker 没跑时前端会无限轮询（表现为提交后长时间无响应）
# AGENT_QUEUE_TIMEOUT_MS=60000
# 任务总时限：running / waiting_model 超过 deadline_at 同样判 timed_out（AGENT_TASK_TIMEOUT）
# AGENT_TASK_TIMEOUT_MS=600000

# 可选：路径覆盖（默认值如下）
# UPSTREAM_MESSAGES_PATH=/anthropic/v1/messages
# UPSTREAM_MODELS_PATH=/models
# UPSTREAM_FILES_PATH=/anthropic/v1/files
# UPSTREAM_ASR_PATH=/v1/tools/asr
# UPSTREAM_TTS_PATH=/v1/tools/tts
# UPSTREAM_BALANCE_PATH=/user/balance
# 余额查询总时限（只读小请求，默认 15s）
# UPSTREAM_BALANCE_TIMEOUT_MS=15000