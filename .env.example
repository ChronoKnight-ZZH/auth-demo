# ---- 服务 ----
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# ---- 密钥与 pepper（生产环境必须通过 Secret 注入，勿提交）----
PEPPER=dev-pepper-change-me-in-production-0123456789

# ---- Argon2id（2C4G 下调档位，方案 §6.2.2）----
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---- 会话 TTL（方案 §10 Q-04 定稿）----
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=604800000
SESSION_TOUCH_THROTTLE_MS=300000

# ---- 登录限流（方案 §10 Q-06 定稿）----
LOGIN_MAX_PER_ACCOUNT=10
LOGIN_MAX_PER_IP=50
LOGIN_WINDOW_SEC=900

# ---- Argon2 并发闸（方案 §6.2.6）----
MAX_CONCURRENT_HASH=2
HASH_QUEUE_LIMIT=32
HASH_QUEUE_TIMEOUT_MS=1000

# ---- 存储后端 ----
# 留空 = 使用内存实现（零依赖开箱可跑）
# 填入即启用真实后端，例如：
# MYSQL_URL=mysql://authdemo:password@127.0.0.1:3306/auth_demo
# REDIS_URL=redis://:password@127.0.0.1:6379/0
MYSQL_URL=
REDIS_URL=
MYSQL_POOL_SIZE=8
