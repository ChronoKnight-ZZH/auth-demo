{
  "name": "auth-demo",
  "version": "1.0.0",
  "private": true,
  "description": "后端登录与凭证验证 Demo：RSA-OAEP 传输 + Argon2id 持久化 + Opaque Token 版本化会话",
  "main": "src/server.js",
  "engines": {
    "node": ">=16.17.0"
  },
  "scripts": {
    "keys": "node scripts/gen-keys.js",
    "migrate": "node scripts/migrate.js --database",
    "seed": "node scripts/seed.js --mysql",
    "admin": "node scripts/admin.js",
    "user:list": "node scripts/admin.js list",
    "user:create": "node scripts/admin.js create",
    "user:lock": "node scripts/admin.js lock",
    "user:unlock": "node scripts/admin.js unlock",
    "user:reset-password": "node scripts/admin.js reset-password",
    "import:history": "node scripts/import-history.js",
    "backup": "node scripts/backup.js",
    "build": "node scripts/build.js",
    "start": "node src/server.js",
    "start:dist": "node dist/src/server.js",
    "dev": "node src/server.js",
    "mock:upstream": "node scripts/mock-upstream.js",
    "mock:echo": "node scripts/echo-upstream.js",
    "test": "node test/unit.test.js && node test/stream.test.js && node test/cors.test.js",
    "smoke": "node scripts/smoke.js",
    "smoke:stream": "node scripts/smoke-stream.js",
    "smoke:echo": "node scripts/smoke-echo.js",
    "test:echo": "node test/echo-upstream.test.js",
    "verify:gate": "node scripts/verify-gate.js",
    "verify:webcrypto": "node scripts/verify-webcrypto.js",
    "verify:all": "node test/unit.test.js && node test/stream.test.js && node test/echo-upstream.test.js && node scripts/smoke.js && node scripts/smoke-stream.js && node scripts/smoke-echo.js && node scripts/verify-gate.js && node scripts/verify-webcrypto.js"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "express": "^5.1.0",
    "ioredis": "^5.4.1",
    "mysql2": "^3.11.4",
    "undici": "^5.28.0"
  }
}
